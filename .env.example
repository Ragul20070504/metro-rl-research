# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# NOTE: none of the primary data sources require credentials. Every dataset in
# docs/data_sources.md §1 is fetched anonymously from data.ny.gov. These variables exist
# only for optional alternative routes and for local path overrides.

# Optional. Only needed if GTFS static is fetched from mta.info/developers instead of the
# credential-free data.ny.gov mirror (fgm6-ccue). The mirror is the default precisely so a
# fresh clone reproduces without secrets.
MTA_API_KEY=

# Optional overrides. Leave blank to use the repo-relative defaults in src/common/paths.py.
METRORL_DATA_DIR=
METRORL_RESULTS_DIR=

# Determinism controls, recorded in every run manifest. Set at M2.
PYTHONHASHSEED=0
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
